# Example: https://www.your-domain.com
NEXT_PUBLIC_SITE_URL=

# Include the country code and digits only. Example format: 91XXXXXXXXXX
NEXT_PUBLIC_WHATSAPP_NUMBER=919033148505

# Google Maps listing and embed configuration
NEXT_PUBLIC_GOOGLE_MAPS_URL=
NEXT_PUBLIC_GOOGLE_MAPS_QUERY=Surat, Gujarat, India
NEXT_PUBLIC_GOOGLE_MAPS_EMBED_KEY=

# Optional GA4 Measurement ID. Analytics stays disabled until this is set and
# a visitor has allowed Google content in the privacy controls.
NEXT_PUBLIC_GA_MEASUREMENT_ID=

# Server-only Places API credentials used by /api/google-reviews
GOOGLE_PLACES_API_KEY=
GOOGLE_PLACE_ID=

# Server-only admin access. Use two DIFFERENT random values, at least 32 characters.
# Never prefix these with NEXT_PUBLIC_ or commit .env.local.
ADMIN_ACCESS_KEY=
ADMIN_SESSION_SECRET=

# Server-only MongoDB configuration. Never use a NEXT_PUBLIC prefix.
MONGODB_URI=
MONGODB_DATABASE=trimurti_coolers
